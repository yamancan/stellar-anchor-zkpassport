{
  "name": "tr-mock-anchor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && tsx scripts/build-anchor-gate.ts",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "zkpassport:browser": "tsx scripts/serve-zkpassport.ts",
    "setup:treasury": "tsx scripts/setup-treasury.ts",
    "mock:usdc": "tsx scripts/issue-mock-usdc.ts",
    "sweep": "tsx scripts/sweep.ts",
    "sep:conformance": "stellar-anchor-tests --home-domain ${HOME_DOMAIN:-https://tr-mock-anchor.fly.dev} --seps 1 10 12 6 38 --asset-code USDC --sep-config anchor-tests.config.json",
    "e2e:sep6": "tsx scripts/e2e-sep6.ts",
    "prepare": "husky",
    "hooks:install": "husky",
    "hooks:check": "node scripts/hooks-policy.mjs staged"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@stellar/freighter-api": "6.0.1",
    "@stellar/stellar-sdk": "^17.0.0",
    "fast-xml-parser": "5.11.1",
    "hono": "^4.13.5",
    "qrcode": "1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stellar/anchor-tests": "^0.6.22",
    "@types/node": "^26.3.0",
    "@types/qrcode": "1.5.6",
    "@zkpassport/sdk": "0.17.1",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13"
  }
}
